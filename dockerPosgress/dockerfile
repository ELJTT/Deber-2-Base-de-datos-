# 1. Usar la imagen oficial y estable de PostgreSQL
FROM postgres:16-alpine

# 2. Metadatos del contenedor
LABEL maintainer="Desarrollo Local <dev@tuempresa.com>"
LABEL description="Contenedor optimizado de PostgreSQL 16"

# 3. Variables de entorno por defecto (pueden ser sobreescritas en el compose)
ENV POSTGRES_USER=postgres
ENV POSTGRES_PASSWORD=root_secure_password_change_me
ENV POSTGRES_DB=mi_base_datos

# 4. Exponer el puerto estándar interno de PostgreSQL
EXPOSE 5432